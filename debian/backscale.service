[Unit]
Description=backscale mesh VPN
Wants=network-online.target
After=network-online.target
# Not configured until `backscale join` has run.
ConditionPathExists=/var/lib/backscale/config.toml

[Service]
Type=exec
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/backscale
ExecStart=/usr/bin/backscale up
Restart=on-failure
RestartSec=5

StateDirectory=backscale
StateDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
